node_modules
dist
dist-ssr
*.local
.DS_Store
*.log

# Capture media travels by hand, not by git. `video/*` rather than
# `video/` on purpose: git will not descend into an excluded directory,
# so a bare `video/` makes the negation below impossible.
#
# The negation covers *.md rather than named files: the handoff docs are
# prose, not media, and must outlive the frame folders that ZACHTODOS tells
# you to delete once the masters are encoded. Naming them one at a time
# already failed once — HANDOFF.md was written next to an ignore rule that
# only knew about HANDOFF-design.md, so git could not see it at all.
video/*
!video/*.md

# signing material — never in history (the 2026-08-03 lesson)
*.keystore
*.jks
android/keystore.properties

# credentials and environment — nothing here today, and the rule exists so
# that stays true. Vite exposes any VITE_-prefixed var to the CLIENT bundle,
# so a committed .env is not merely private-in-a-public-repo, it ships. The
# store/signing lesson above was learned by nearly losing a keystore to git;
# this one is written down before the equivalent happens.
.env
.env.*
!.env.example
*.pem
*.p12
*.p8
google-services.json
service-account*.json

# capture output — media never enters history
frames/
frames-*/
*.mp4

# Claude Code runtime state — the checked-in parts of .claude/ are
# settings.json and agents/, not session locks
.claude/scheduled_tasks.lock

# the captain's private command deck — crew notes and summon phrases
# stay local; the committed role cards live in .claude/agents/
claudeteam/
