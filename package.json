{
  "name": "echogalaxy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A free, open educational tool for exploring galaxies and the universe.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "capture:social": "node scripts/capture-social.mjs",
    "sync:tsl": "node scripts/sync-tsl-lib.mjs && npm run check:tsl && npm run build",
    "check:tsl": "node scripts/check-tsl-lib.mjs && node scripts/smoke-tsl-lib.mjs",
    "check:content": "node scripts/check-astronomy-content.mjs",
    "check:shots": "node scripts/check-shots.mjs",
    "check:planet": "node scripts/smoke-planet.mjs",
    "check:shaders": "node scripts/smoke-lab-shaders.mjs",
    "check:frozen": "node scripts/check-frozen.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "check:mobile": "node scripts/check-mobile.mjs",
    "check:all": "npm run check:tsl && npm run check:content && npm run check:planet && npm run check:shots",
    "backlog:csv": "node scripts/backlog-to-csv.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.12"
  }
}
