# Copy to android/keystore.properties (gitignored) and fill in.
# Generate a fresh keystore first — the previously committed one is
# burned:
#   keytool -genkey -v -keystore app/release.keystore -alias echogalaxy-key -keyalg RSA -keysize 2048 -validity 10000
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=echogalaxy-key
keyPassword=CHANGE_ME
